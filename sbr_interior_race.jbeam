        ["indicatorStop", "event:>Vehicle>Interior>Indicator>FIPA_Off"],
        ["indLoop1", "event:>Vehicle>Interior>Indicator>AU5_V2_Click"],
        ["indLoop2", "event:>Vehicle>Interior>Indicator>AU5_V2_Clack"],
