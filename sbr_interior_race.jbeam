        {"selfCollision":true},
        {"collision":true},
        //dash cam
        ["dash", 0.369, 0.19, 1.01, 55, "f1ll","f2r","f3ll","f4ll","f4r",[]{"beamDeform":5001000,"beamStrength":"FLT_MAX"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
