    ],
    "props": [
        ["func",       "mesh",              "idRef:", "idX:", "idY:", "baseRotation",            "rotation",               "translation",           "min", "max", "offset", "multiplier"],
        //pedals
        ["brake",      "sbr_brakepedal",    "f1l","f1r","f6l",        {"x":0, "y":0, "z":180},   {"x":-20, "y":0, "z":0},   {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
        ["throttle",   "sbr_gaspedal",      "f1l","f1r","f6l",        {"x":0, "y":0, "z":180},   {"x":20, "y":0, "z":0},    {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
        //turn signal stalk
        ["turnsignal", "sbr_signalstalk",   "f1l","f1r","f6l",        {"x":0, "y":0, "z":180},    {"x":0, "y":-13, "z":-8},  {"x":0, "y":0, "z":0}, -1, 1, 0, 1],
        //wiper stalk
